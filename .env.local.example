NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose this to the client or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Shared secret for /api/cron/process-jobs — generate with
# `openssl rand -hex 32`. Vercel Cron sends this automatically as
# `Authorization: Bearer $CRON_SECRET` once this env var is set on the
# project; any other scheduler must send the same header itself.
CRON_SECRET=your-cron-secret

# Server-only. Phase 6: shared Google service account used to sync listings
# to every organization's connected Google Sheet — one platform-level
# credential, not per-org OAuth. Create a service account in Google Cloud
# Console, enable the Google Sheets API, generate a JSON key, and paste the
# ENTIRE JSON as a single line here. Each organization then shares edit
# access on their spreadsheet with this key's `client_email` (shown in the
# integrations settings page) to "connect" it — no authorization-code
# exchange or refresh tokens to manage.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"...","private_key":"..."}

# Used to build absolute URLs (e.g. the "Listing URL" column synced to
# Google Sheets) from background workers that have no incoming request to
# derive an origin from. Falls back to a relative /properties/<slug> path
# when unset.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
